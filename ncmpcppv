#!/bin/bash

self=$(readlink -f "$0")
session=ncmpcppv
cache="${XDG_RUNTIME_DIR:-/tmp}/ncmpcppv-cover-$(id -u)"

have() { command -v "$1" >/dev/null 2>&1; }

pane_loop() {
	draw=$1
	trap '"$draw"' WINCH
	printf '\033[?25l'
	"$draw"
	while :; do
		sleep 60 &
		wait $!
	done
}

draw_note() {
	local rows cols top left i=0 line
	rows=$(tput lines) cols=$(tput cols)
	top=$(( (rows - 8) / 2 )) left=$(( (cols - 18) / 2 ))
	[ "$top" -lt 0 ] && top=0
	[ "$left" -lt 0 ] && left=0
	printf '\033[2J\033[38;2;184;86;127m'
	while IFS= read -r line; do
		printf '\033[%d;%dH%s' $((top + i + 1)) $((left + 1)) "$line"
		i=$((i + 1))
	done <<'EOF'
      ████████████
      █          █
      █          █
      █          █
      █          █
  ▗▄▄▄█      ▗▄▄▄█
▄██████    ▄██████
▜███▛▀     ▜███▛▀
EOF
	printf '\033[0m'
}

draw_chafa() {
	printf '\033[2J\033[H'
	chafa --size="$(tput cols)x$(tput lines)" "$cache" 2>/dev/null
}

music_dir() {
	local d f
	if [ -n "${NCMPCPPV_MUSIC_DIR:-}" ]; then
		d=$NCMPCPPV_MUSIC_DIR
	else
		for f in "$HOME/.config/ncmpcpp/config" "$HOME/.ncmpcpp/config"; do
			[ -f "$f" ] || continue
			d=$(sed -n 's/^[[:space:]]*mpd_music_dir[[:space:]]*=[[:space:]]*//p' "$f" | tail -n 1)
			[ -n "$d" ] && break
		done
		if [ -z "$d" ]; then
			for f in "${XDG_CONFIG_HOME:-$HOME/.config}/mpd/mpd.conf" "$HOME/.mpdconf" "$HOME/.mpd/mpd.conf" /etc/mpd.conf; do
				[ -r "$f" ] || continue
				d=$(sed -n 's/^[[:space:]]*music_directory[[:space:]]*//p' "$f" | tail -n 1)
				[ -n "$d" ] && break
			done
		fi
		[ -n "$d" ] || d="$HOME/Music"
	fi
	d=${d#\"} d=${d%\"}
	case $d in
	\~) d=$HOME ;;
	\~/*) d="$HOME/${d#\~/}" ;;
	esac
	printf '%s\n' "${d%/}"
}

is_image() {
	if [ -s "$cache" ]; then
		case $(file -b --mime-type "$cache" 2>/dev/null) in
		image/*) return 0 ;;
		esac
	fi
	rm -f "$cache"
	return 1
}

mpd_conf() {
	local f
	for f in "${XDG_CONFIG_HOME:-$HOME/.config}/mpd/mpd.conf" "$HOME/.mpdconf" "$HOME/.mpd/mpd.conf" /etc/mpd.conf; do
		[ -r "$f" ] && { printf '%s\n' "$f"; return; }
	done
}

cava_feed() {
	local conf skip f
	conf=$(mpd_conf)
	[ -n "$conf" ] || return
	for f in "$HOME/.config/ncmpcpp/config" "$HOME/.ncmpcpp/config"; do
		[ -f "$f" ] || continue
		skip=$(sed -n 's/^[[:space:]]*visualizer_data_source[[:space:]]*=[[:space:]]*//p' "$f" | tail -n 1)
		skip=${skip#\"} skip=${skip%\"}
	done
	awk -v skip="$skip" '
	/^[[:space:]]*audio_output/ { inb = 1; t = n = p = fm = ""; next }
	inb && /^[[:space:]]*}/ {
		if (t == "fifo" && p != "" && p != skip) print (tolower(n) ~ /cava/ ? 0 : 1) "|" p "|" fm
		inb = 0; next
	}
	inb {
		k = $1; v = $0
		sub(/^[[:space:]]*[^[:space:]]+[[:space:]]+/, "", v)
		sub(/[[:space:]]+$/, "", v); gsub(/^"|"$/, "", v)
		if (k == "type") t = v; else if (k == "name") n = v; else if (k == "path") p = v; else if (k == "format") fm = v
	}' "$conf" | sort | head -n 1 | cut -d'|' -f2-
}

draw_nofeed() {
	local cols
	cols=$(tput cols)
	printf '\033[2J\033[H\033[38;2;139;154;184m'
	printf 'Visualizer off. MPD needs a fifo output for it, see the ncmpcppv README.\n' | fold -s -w "$cols"
	printf '\033[0m'
}

song_change() {
	local file dir folder img
	[ -n "${NCMPCPPV_HOOK:-}" ] && sh -c "$NCMPCPPV_HOOK" >/dev/null 2>&1 &

	file=$(mpc current -f %file% 2>/dev/null)
	if [ -z "$file" ]; then
		sleep 0.3
		file=$(mpc current -f %file% 2>/dev/null)
	fi
	rm -f "$cache"

	if [ -n "$file" ]; then
		mpc readpicture "$file" > "$cache" 2>/dev/null
		dir=$(music_dir)
		folder=$(dirname "$dir/$file")
		if ! is_image && have ffmpeg && [ -f "$dir/$file" ]; then
			ffmpeg -nostdin -y -loglevel quiet -i "$dir/$file" -an -vcodec copy -f image2 "$cache" 2>/dev/null
		fi
		if ! is_image && [ -d "$folder" ]; then
			img=$(find "$folder" -maxdepth 1 -type f -iregex '.*\.\(jpe?g\|png\|webp\|gif\|bmp\)' | sort |
				awk '{ a[NR] = $0 } tolower($0) ~ /\/(cover|folder|front|album)[^\/]*$/ { print; f = 1; exit } END { if (!f && NR) print a[1] }')
			[ -n "$img" ] && cp "$img" "$cache"
		fi
		is_image || mpc albumart "$file" > "$cache" 2>/dev/null
		is_image
	fi

	redraw
}

redraw() {
	local id x y w h state mode
	id=$(tmux show-options -v -t "$session" @ncmpcppv-art 2>/dev/null)
	[ -n "$id" ] || return
	read -r x y w h <<< "$(tmux display-message -p -t "$id" '#{pane_left} #{pane_top} #{pane_width} #{pane_height}' 2>/dev/null)"
	[ -n "$h" ] || return
	state=$(tmux display-message -p -t "$id" '#{@ncmpcppv}')

	if [ ! -s "$cache" ]; then
		mode=note
	elif [ -p "${FIFO_UEBERZUG:-}" ]; then
		mode=image
	elif have chafa; then
		mode=chafa
	else
		mode=note
	fi

	[ -p "${FIFO_UEBERZUG:-}" ] && printf '{"action":"remove","identifier":"ncmpcppv"}\n' > "$FIFO_UEBERZUG"

	if [ "$mode" != "$state" ] || [ "$mode" = chafa ]; then
		case $mode in
		image) tmux respawn-pane -k -t "$id" "sleep infinity" ;;
		*) tmux respawn-pane -k -t "$id" "$(printf '%q' "$self") --pane $mode" ;;
		esac
		tmux set-option -p -t "$id" @ncmpcppv "$mode"
	fi

	if [ "$mode" = image ]; then
		sleep 0.05
		printf '{"action":"add","identifier":"ncmpcppv","x":%d,"y":%d,"width":%d,"height":%d,"path":"%s"}\n' \
			"$x" "$y" "$w" "$h" "$cache" > "$FIFO_UEBERZUG"
	fi
}

case ${1:-} in
--song-change)
	song_change
	exit
	;;
--redraw)
	redraw
	exit
	;;
--run)
	shift
	i=0
	while [ "$(tmux display-message -p -t "$session" '#{session_attached}' 2>/dev/null)" = 0 ] && [ "$i" -lt 100 ]; do
		sleep 0.05
		i=$((i + 1))
	done
	sleep 0.2
	while :; do
		start=$SECONDS
		"$@" && break
		[ $((SECONDS - start)) -ge 2 ] || break
		while [ "$(tput cols)" -lt 30 ] || [ "$(tput lines)" -lt 10 ]; do
			sleep 0.5
		done
	done
	tmux kill-session -t "$session"
	exit
	;;
--pane)
	case ${2:-} in
	chafa) pane_loop draw_chafa ;;
	nofeed) pane_loop draw_nofeed ;;
	*) pane_loop draw_note ;;
	esac
	;;
esac

for p in ncmpcpp tmux mpc; do
	have "$p" || { echo "ncmpcppv: $p is not installed" >&2; exit 1; }
done

unset TMUX
tmux kill-session -t "$session" 2>/dev/null

tmp=$(mktemp -d "${TMPDIR:-/tmp}/ncmpcppv.XXXXXX") || exit 1
hook=
conf=()
for f in "$HOME/.config/ncmpcpp/config" "$HOME/.ncmpcpp/config"; do
	[ -f "$f" ] || continue
	n=${#conf[@]}
	h=$(sed -n 's/^[[:space:]]*execute_on_song_change[[:space:]]*=[[:space:]]*//p' "$f" | tail -n 1)
	if [ -n "$h" ]; then
		h=${h#\"} h=${h%\"}
		hook=$h
	fi
	grep -v '^[[:space:]]*execute_on_song_change[[:space:]]*=' "$f" > "$tmp/$n"
	conf+=(-c "$tmp/$n")
done
printf 'execute_on_song_change = "%s --song-change"\n' "$self" > "$tmp/ncmpcppv"
conf+=(-c "$tmp/ncmpcppv")

ub_pid=
FIFO_UEBERZUG=
ub='' out=${NCMPCPPV_OUTPUT:-}
if have ueberzugpp; then
	if [ -z "$out" ]; then
		if [ -n "${KITTY_WINDOW_ID:-}" ] || [ -n "${KONSOLE_VERSION:-}" ] || [ -n "${WEZTERM_PANE:-}" ] || [ "${TERM:-}" = xterm-ghostty ]; then
			out=kitty
		else
			case ${TERM:-} in foot*) out=sixel ;; esac
		fi
	fi
	ub="ueberzugpp layer --silent --no-cache${out:+ -o $out}"
elif have ueberzug; then
	ub="ueberzug layer --silent --parser json"
fi
case $out in
kitty | sixel) usable=1 ;;
*) [ -n "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ] && [ -z "${SSH_TTY:-}" ] && usable=1 ;;
esac
if [ -n "${usable:-}" ] && [ -n "$ub" ]; then
	FIFO_UEBERZUG="$tmp/ueberzug"
	if mkfifo "$FIFO_UEBERZUG"; then
		$ub < "$FIFO_UEBERZUG" &
		ub_pid=$!
		exec 3>"$FIFO_UEBERZUG"
	else
		FIFO_UEBERZUG=
	fi
fi

cleanup() {
	[ -n "${watcher:-}" ] && kill "$watcher" 2>/dev/null
	tmux kill-session -t "$session" 2>/dev/null
	exec 3>&-
	[ -n "$ub_pid" ] && kill "$ub_pid" 2>/dev/null
	rm -rf "$tmp"
	rm -f "$cache"
}
trap cleanup EXIT
trap 'exit 1' INT TERM HUP

export FIFO_UEBERZUG NCMPCPPV_HOOK="$hook"

main=$(tmux new-session -d -P -F '#{pane_id}' -s "$session" -x "$(tput cols)" -y "$(tput lines)" \
	-e "FIFO_UEBERZUG=$FIFO_UEBERZUG" -e "NCMPCPPV_HOOK=$hook" \
	"$(printf '%q ' "$self" --run ncmpcpp "${conf[@]}" "$@")") || exit 1
tmux set-option -t "$session" status off >/dev/null
art=$(tmux split-window -h -P -F '#{pane_id}' -t "$main" -l 28% "sleep infinity")
tmux set-option -t "$session" @ncmpcppv-art "$art"
vis=
if have cava; then
	feed=$(cava_feed)
	if [ -n "$feed" ]; then
		fmt=${feed#*|} fifo=${feed%%|*}
		rate=${fmt%%:*} bits=${fmt#*:} bits=${bits%%:*}
		case $rate in '' | *[!0-9]*) rate=44100 ;; esac
		case $bits in '' | *[!0-9]*) bits=16 ;; esac
		cconf="${XDG_CONFIG_HOME:-$HOME/.config}/cava/config"
		if [ -f "$cconf" ]; then
			awk '/^[[:space:]]*\[/ { skip = ($0 ~ /^[[:space:]]*\[input\]/) } !skip' "$cconf" > "$tmp/cava"
		else
			: > "$tmp/cava"
		fi
		printf '\n[input]\nmethod = fifo\nsource = %s\nsample_rate = %s\nsample_bits = %s\n' "$fifo" "$rate" "$bits" >> "$tmp/cava"
		viscmd="sh -c 'while :; do cava -p $tmp/cava; sleep 1; done'"
	else
		viscmd="$(printf '%q' "$self") --pane nofeed"
	fi
	vis=$(tmux split-window -v -P -F '#{pane_id}' -t "$art" -l 30% "$viscmd")
fi
tmux select-pane -t "$main"
for p in "$art" $vis; do
	tmux select-pane -d -t "$p"
	tmux set-hook -t "$session" -a pane-mode-changed "if -F -t $p '#{pane_in_mode}' 'send-keys -t $p -X cancel'"
done
tmux set-hook -t "$session" after-select-pane "select-pane -t $main"

NCMPCPPV_HOOK='' "$self" --song-change &

(
	last='' size=''
	while tmux has-session -t "$session" 2>/dev/null; do
		win=$(tmux display-message -p -t "$main" '#{window_width} #{window_height} #{client_cell_width} #{client_cell_height}' 2>/dev/null)
		if [ -n "$win" ] && [ "$win" != "$size" ]; then
			size=$win
			read -r ww wh cw ch <<< "$win"
			w=$(( ww * 28 / 100 ))
			[ "$w" -gt $(( ww - 31 )) ] && w=$(( ww - 31 ))
			[ "$w" -lt 1 ] && w=1
			tmux resize-pane -t "$art" -x "$w" 2>/dev/null
			if [ -n "$vis" ]; then
				if [ "${cw:-0}" -gt 0 ] && [ "${ch:-0}" -gt 0 ]; then
					h=$(( (w * cw + ch - 1) / ch ))
				else
					h=$(( (w + 1) / 2 ))
				fi
				[ "$h" -gt $(( wh - 5 )) ] && h=$(( wh - 5 ))
				[ "$h" -lt 3 ] && h=3
				tmux resize-pane -t "$art" -y "$h" 2>/dev/null
			fi
		fi
		geo=$(tmux display-message -p -t "$art" '#{pane_width}x#{pane_height}+#{pane_left}+#{pane_top}' 2>/dev/null)
		if [ -n "$geo" ] && [ "$geo" != "$last" ]; then
			last=$geo
			"$self" --redraw
		fi
		sleep 0.3
	done
) &
watcher=$!

TMUX='' tmux attach-session -t "$session"
